<?xml version="1.0" encoding="UTF-8"?>
<!-- Extra trim candidates on top of the manifest's official remove-minimal.xml.
     Entries are matched by path OR name against the resolved manifest by
     scripts/apply-trim.py; anything not present is silently skipped, so it is
     safe to list projects from any manifest revision here.

     These are all unneeded for "mka recoveryimage" on a real device: network
     simulators, ART/dex tooling, mainline module sources (Bluetooth/Wi-Fi/
     media), and huge SDK/VNDK snapshots. -->
<manifest>
    <!-- The project that blew up the sync: network simulator for virtual devices. -->
    <remove-project path="tools/netsim" />

    <!-- ART / dex tooling: recovery contains no dex code. -->
    <remove-project path="art" />

    <!-- Mainline module sources: recovery links none of these. -->
    <remove-project path="packages/modules/Bluetooth" />
    <remove-project path="packages/modules/Connectivity" />
    <remove-project path="packages/modules/Wifi" />
    <remove-project path="packages/modules/UWB" />
    <remove-project path="packages/modules/Media" />
    <remove-project path="packages/modules/MediaProvider" />
    <remove-project path="packages/modules/IPsec" />
    <remove-project path="packages/modules/DnsResolver" />
    <remove-project path="packages/modules/StatsD" />
    <remove-project path="packages/modules/Permission" />

    <!-- SDK / VNDK snapshot plumbing not used by a recovery image. -->
    <remove-project path="sdk" />
    <remove-project path="prebuilts/vndk" />
    <remove-project path="prebuilts/fullsdk" />
    <remove-project path="prebuilts/sdk" />
</manifest>
